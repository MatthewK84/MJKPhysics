{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Rust format",
            "integration_id": 15368
          },
          {
            "context": "Clippy",
            "integration_id": 15368
          },
          {
            "context": "Tests (Linux)",
            "integration_id": 15368
          },
          {
            "context": "Crate layering",
            "integration_id": 15368
          },
          {
            "context": "Power of Ten",
            "integration_id": 15368
          },
          {
            "context": "Supply chain",
            "integration_id": 15368
          },
          {
            "context": "Spelling",
            "integration_id": 15368
          },
          {
            "context": "Coverage",
            "integration_id": 15368
          },
          {
            "context": "Mutation testing (changed lines)",
            "integration_id": 15368
          },
          {
            "context": "API docs",
            "integration_id": 15368
          },
          {
            "context": "WebAssembly build",
            "integration_id": 15368
          },
          {
            "context": "Native and WebAssembly agree",
            "integration_id": 15368
          },
          {
            "context": "Viewer",
            "integration_id": 15368
          },
          {
            "context": "Docs site",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
