{
  "name": "mjk-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Browser viewer for MJKPhysics. The renderer arrives with milestone M3.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:scripts": "tsc -p scripts && tsc -p ../assets/readme && tsc -p ../docs/theme",
    "lint:scripts": "cd .. && eslint --config viewer/eslint.config.js --max-warnings 0 assets/readme docs/theme",
    "format:scripts": "prettier --config .prettierrc.json --check ../assets/readme/*.{js,mjs,ts,json} ../docs/theme/*.{js,ts,json}",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run typecheck:scripts && npm run lint:scripts && npm run format:scripts && npm run lint:ui",
    "lint:ui": "node scripts/lint-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
